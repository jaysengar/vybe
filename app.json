{
  "expo": {
    "name": "VYBE",
    "slug": "vybe-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "vybe",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VYBE to access your camera so you can be seen by matches."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow VYBE to access your camera for video calls.",
          "microphonePermission": "Allow VYBE to access your microphone for video calls."
        }
      ]
    ],
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "Allow VYBE to access your camera so you can be seen by matches.",
        "NSMicrophoneUsageDescription": "Allow VYBE to access your microphone so matches can hear you."
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.vybe.mobile",
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1625",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.vybe.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c91e709-902f-4818-b77c-3bc94bdd901f"
      }
    }
  }
}
